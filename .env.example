# ─── Site ──────────────────────────────────────────────
# Public URL used for canonical links, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.vijstack.com

# ─── Contact form (Resend: https://resend.com) ────────
# Without RESEND_API_KEY the form shows an error and asks visitors to email you directly.
RESEND_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=vijstack@gmail.com
# Must be a sender on a domain you verified in Resend
CONTACT_FROM_EMAIL="Vijstack Website <hello@vijstack.com>"

# ─── Google Business Profile ──────────────────────────
# Link for "Read reviews on Google" buttons
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://share.google/8pqohNwlk24HagBEa
# Optional: your real Google rating, shown on the site and in JSON-LD.
# Leave blank to hide. Only use the numbers shown on your Google profile.
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=

# ─── Search Console & analytics (optional) ────────────
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
